{
  "name": "npcprotocol",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves matching static files directly and never
    // invokes the Worker — which would mean no security headers on any HTML
    // page and no branded 404. Running the Worker first is what makes those
    // apply to every response.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
